# Credentials and account identifiers. accounts.toml is the old name and
# stays listed so an un-renamed copy cannot be committed by accident.
config.toml
accounts.toml

# Session dumps: effectively keys to the account
.explore-session*.json

# The Enable Banking private key, wherever it lands
*.pem

# Collected data
balances.db*

.venv/
__pycache__/

# Editor backups: accounts.toml~ would carry real account hashes
*~
*.swp
